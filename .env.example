# =============================================================================
# tgbotstory2 — Environment Variables
# =============================================================================
# Copy this file to .env and replace all placeholders with real values.
#   cp .env.example .env
#
# NEVER commit .env to version control!
# =============================================================================

# --- Telegram Bot ---
# Get from @BotFather: https://t.me/BotFather
BOT_TOKEN=replace_me_with_botfather_token

# Comma-separated Telegram user IDs of bot administrators
# These users can add auth credentials and manage targets
ADMIN_IDS=123456789,987654321

# Default Telegram chat ID for content delivery (optional)
CHAT_ID=0

# --- VK (VKontakte) ---
# User token (required for stories.get, wall.get for user profiles)
# Get at: https://vkhost.github.io/ (vk.com app) or VK Admin
VK_USER_TOKEN=replace_me_with_vk_user_token

# Service token (for public pages only, wall.get)
# Get at: https://vk.com/apps?act=manage → Create App → Settings → Service Key
VK_SERVICE_TOKEN=replace_me_with_vk_service_token

# --- Instagram* ---
# Login credentials for instagrapi
# *Meta Platforms Inc. activity is prohibited in Russia
IG_USERNAME=replace_me_with_instagram_username
IG_PASSWORD=replace_me_with_instagram_password

# --- TikTok ---
# ms_token for TikTokApi
# See: https://github.com/davidteather/TikTok-Api
TT_MS_TOKEN=replace_me_with_tiktok_ms_token

# --- Database ---
# SQLite with async driver (WAL mode, foreign keys ON)
DB_PATH=sqlite+aiosqlite:///data/bot.db

# --- Encryption ---
# Generated ONCE at setup via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts auth credentials (tokens, cookies, session files) at rest in the database
ENCRYPTION_KEY=replace_me_with_generated_fernet_key

# --- Polling ---
# Timeout per poll request (seconds)
POLL_TIMEOUT=30

# Maximum concurrent poll operations (across all targets)
MAX_CONCURRENT_POLLS=3

# --- Media ---
# Temporary directory for downloaded media files
# Files are deleted immediately after sending to Telegram
TEMP_MEDIA_DIR=/tmp/tgbotstory2_media

# Maximum media file size for Telegram upload (MB)
# Telegram limit: 50 MB (bot API)
MAX_MEDIA_SIZE_MB=50

# --- Logging ---
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# File log path (rotated: 10 MB × 3 files)
LOG_FILE=logs/bot.log
