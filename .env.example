# =============================================================================
# tgbotstory2 — Environment Variables (Bothost deployment)
# =============================================================================
# Bothost auto-sets BOT_TOKEN from the platform.
# Copy this file to .env and fill in your platform credentials.
#   cp .env.example .env
#
# NEVER commit .env to version control!
# =============================================================================

# --- Telegram Bot ---
# BOT_TOKEN is auto-set by Bothost platform — no need to set it here.
# Admin IDs: comma-separated Telegram user IDs of bot administrators
ADMIN_IDS=123456789,987654321

# Default Telegram chat ID for content delivery (optional)
CHAT_ID=0

# --- VK (VKontakte) ---
# User token (required for stories.get, wall.get for user profiles)
# Get at: https://vkhost.github.io/ (vk.com app) or VK Admin
VK_USER_TOKEN=replace_me_with_vk_user_token

# Service token (for public pages only, wall.get)
# Get at: https://vk.com/apps?act=manage → Create App → Settings → Service Key
VK_SERVICE_TOKEN=replace_me_with_vk_service_token

# --- Instagram* ---
# Login credentials for instagrapi
# *Meta Platforms Inc. activity is prohibited in Russia
IG_USERNAME=replace_me_with_instagram_username
IG_PASSWORD=replace_me_with_instagram_password

# --- TikTok ---
# ms_token for TikTokApi
# See: https://github.com/davidteather/TikTok-Api
TT_MS_TOKEN=replace_me_with_tiktok_ms_token

# --- Database ---
# SQLite with async driver, stored in persistent /app/data volume
DB_PATH=sqlite+aiosqlite:////app/data/bot.db

# --- Encryption ---
# Generated ONCE via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace_me_with_generated_fernet_key

# --- Polling ---
POLL_TIMEOUT=30
MAX_CONCURRENT_POLLS=3

# --- Media ---
# Temporary directory inside persistent /app/data volume
TEMP_MEDIA_DIR=/app/data/tmp
MAX_MEDIA_SIZE_MB=50

# --- Logging ---
# Logs go to stdout (Docker standard). Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO