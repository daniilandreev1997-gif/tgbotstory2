[Unit]
Description=Telegram Bot: VK/Instagram/TikTok Content Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/tgbotstory2
Environment="PATH=/home/user/tgbotstory2/venv/bin:/usr/bin:/bin"
ExecStart=/home/user/tgbotstory2/venv/bin/python -m bot.main
Restart=always
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=60
WatchdogSec=60

# Graceful shutdown: SIGTERM -> 30s timeout -> SIGKILL
TimeoutStopSec=30
KillMode=mixed

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/user/tgbotstory2
ReadWritePaths=/tmp/tgbotstory2_media
ReadOnlyPaths=/home/user/tgbotstory2/venv

[Install]
WantedBy=multi-user.target
